{
  "manifest_version": 3,
  "name": "Annotator for arXiv",
  "version": "0.1.0",
  "description": "Keyboard-first, margin-style annotation for arXiv papers: highlights, underlines, notes, open questions.",

  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],

  "host_permissions": ["*://arxiv.org/*", "*://export.arxiv.org/*"],

  "background": { "service_worker": "background.js" },

  "action": { "default_title": "Annotate this paper" },

  "content_scripts": [
    {
      "matches": ["*://arxiv.org/abs/*", "*://arxiv.org/html/*"],
      "js": ["markdown.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
